### CareerPilot Local (example env)
### Copy to .env and adjust. Do not commit .env.

# --- Docker Compose (mysql + backend + frontend; see README Quick Start) ---
# `docker compose up --build` loads this file. Compose overrides backend DB_HOST to mysql and sets in-container
# BACKEND_PORT=8080. Keep DB_HOST=localhost below for running the backend on the host (e.g. scripts/local-up.sh).
# Published ports on host: DB_PORT→3306, BACKEND_PORT→8080 (API), FRONTEND_PORT→3000 (SPA via nginx :80).
# Frontend image build arg VITE_API_BASE_URL must be a URL the browser can use (default http://localhost:8080).

# --- MySQL (Docker / docker-compose) ---
# Must match DB_NAME below (default database name for init scripts).
MYSQL_ROOT_PASSWORD=careerpilot_root_password
MYSQL_DATABASE=careerpilot
MYSQL_USER=careerpilot
MYSQL_PASSWORD=careerpilot_password

# --- App database connection (backend reads DB_* from the environment) ---
# Backend runs on your Mac/Windows host → use localhost (NOT "mysql").
# Use DB_HOST=mysql only if the backend container shares the Compose network with this service.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=careerpilot
DB_USER=careerpilot
DB_PASSWORD=careerpilot_password

# --- Backend ---
# Host port published for the API when using Docker Compose (`backend` service listens on 8080 inside the container).
BACKEND_PORT=8080

# --- Auth / JWT (Day 6) ---
# Required. Must NOT be empty or start with "change-me" or the server will refuse to start.
# Generate: openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_ISSUER=careerpilot-local
JWT_AUDIENCE=careerpilot-local
JWT_REALM=careerpilot
JWT_TTL_SECONDS=604800

# --- AI provider (scripts: scripts/common/ai_provider.py) ---
# Privacy / modes: see docs/ai-setup.md
# AI_PROVIDER: mock | openai | gemini  (if unset, falls back to AI_MODE for backward compatibility)
AI_PROVIDER=mock
AI_MODE=mock
# OpenAI
AI_MODEL=gpt-4o-mini
AI_API_BASE_URL=
AI_API_KEY=
# Gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE_URL=
GEMINI_API_KEY=
# Optional timeouts (seconds) for AI HTTP clients
# AI_CONNECT_TIMEOUT_SEC=15
# AI_TIMEOUT_SEC=120

# --- Frontend ---
# Browser → API base URL (also used at `docker compose build` for the nginx/static bundle).
VITE_API_BASE_URL=http://localhost:8080
# Host port for the static SPA when using Compose (`frontend` nginx listens on 80 in-container).
FRONTEND_PORT=3000
