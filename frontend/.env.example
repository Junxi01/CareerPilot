# Copy to `.env.local` in this directory (Vite loads `.env`, `.env.local`, etc. from `frontend/`).
#
# **Vite rule:** only variables prefixed with `VITE_` are exposed to browser code via `import.meta.env`.
# Do not use `API_BASE_URL` without the prefix — it will be undefined in the client bundle.
#
# If the browser shows CORS errors, confirm the backend allows your dev origin (see Ktor `install(CORS)` in
# `backend/src/main/kotlin/com/careerpilot/Application.kt`).
#
VITE_API_BASE_URL=http://localhost:8080
